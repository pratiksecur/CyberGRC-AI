# ==========================================================
# CyberGRC-AI Environment Configuration
# ==========================================================
#
# Copy this file to .env for local development.
#
# IMPORTANT:
# - Never commit .env
# - Replace every placeholder with a real value
# - Production must use a strong SECRET_KEY
#


# ==========================================================
# APPLICATION
# ==========================================================

ENVIRONMENT=development

PROJECT_NAME=CyberGRC AI

PROJECT_VERSION=1.0.0


# ==========================================================
# POSTGRESQL
# ==========================================================

POSTGRES_PASSWORD=change-me-to-a-strong-database-password

DATABASE_URL=postgresql://postgres:change-me-to-a-strong-database-password@localhost:5432/cybergrc


# ==========================================================
# AUTHENTICATION
# ==========================================================

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30


# ==========================================================
# REQUEST / UPLOAD SECURITY
# ==========================================================

MAX_REQUEST_BODY_BYTES=12582912

MAX_UPLOAD_SIZE_BYTES=10485760


# ==========================================================
# CORS
# ==========================================================

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ==========================================================
# AI
# ==========================================================

AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434/api/generate

OLLAMA_MODEL=mistral

OLLAMA_TIMEOUT=120