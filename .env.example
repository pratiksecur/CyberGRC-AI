# ==========================================================
# CyberGRC-AI Environment Configuration
# ==========================================================
# Copy to .env for local development.
# Never commit .env or production secrets.

ENVIRONMENT=development
PROJECT_NAME=CyberGRC AI
PROJECT_VERSION=1.0.0

POSTGRES_PASSWORD=change-me-to-a-strong-database-password
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-database-password@localhost:5432/cybergrc

SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MAX_REQUEST_BODY_BYTES=12582912
MAX_UPLOAD_SIZE_BYTES=10485760

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
TRUSTED_HOSTS_ENABLED=false
PROXY_HEADERS_ENABLED=false
FORWARDED_ALLOW_IPS=127.0.0.1
API_DOCS_ENABLED=true
ENABLE_HSTS=false

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30

METRICS_ENABLED=true
METRICS_AUTH_TOKEN=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_BATCH_SIZE=250
SCHEDULER_LOCK_KEY=704001

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=120

# ==========================================================
# Production deployment notes
# ==========================================================
# For staging/production, explicitly set:
# ENVIRONMENT=production
# CORS_ORIGINS=https://your-frontend.example.com
# ALLOWED_HOSTS=api.example.com
# TRUSTED_HOSTS_ENABLED=true
# PROXY_HEADERS_ENABLED=true
# FORWARDED_ALLOW_IPS=<trusted-reverse-proxy-address-or-network>
# API_DOCS_ENABLED=false
# ENABLE_HSTS=true
# METRICS_ENABLED=true
# METRICS_AUTH_TOKEN=<strong-random-token>
# Do not copy the development localhost values above into production.
